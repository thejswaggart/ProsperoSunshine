+/* ProsperoSunshine PS4 port: game-audio capture on the running session. OpenAudioEx takes a 16-byte caller-supplied config
+ * (RemotePlay's exact bytes; see ps_pbs_audio_open) and returns its own handle; the handle is then Started, Read (exported
+ * ReadAudio, same worker path as video) and Stop/Close like the video channel. Serialise audio and video reads externally:
+ * both drive the one shared injection context. */
+int pbs_ps4_remote_audio_open(void **handle, const void *config, size_t config_size) {
+  if (!remote_ready() || !handle || !config || config_size == 0 || config_size > 0x40) return -1;
+  *handle = 0;
+  if (!fn_open_audio) {
+    fn_open_audio = pbs_resolve_in(ctx.pid, "libSceAvcap.sprx", "sceVshAvcapOpenAudioEx");
+    if (!fn_open_audio) { fprintf(report, "Remote Avcap OpenAudioEx unresolved\n"); return -1; }
+  }
+  if (!audio_reader.read &&
+      pbs_ps4_export_reader_init_symbol(&audio_reader, &ctx, "sceVshAvcapReadAudio")) {
+    fprintf(report, "Remote Avcap audio reader (ReadAudio) unavailable\n");
+    return -1;
+  }
+  uint64_t out_handle = 0xa5a5a5a5a5a5a5a5ULL;
+  if (pbs_inject_write_at(&ctx, ctx.scratch + PBS_PS4R_REQUEST_OFF, config, config_size) ||
+      pbs_inject_write_at(&ctx, ctx.scratch + PBS_PS4R_HANDLE_OFF, &out_handle, sizeof out_handle)) {
+    fprintf(report, "Remote Avcap OpenAudio scratch write failed\n");
+    return -1;
+  }
+  long rc = pbs_inject_call_fast(&ctx, fn_open_audio, (uint64_t[6]){
+      (uint64_t)(ctx.scratch + PBS_PS4R_HANDLE_OFF),
+      (uint64_t)(ctx.scratch + PBS_PS4R_REQUEST_OFF), 0, 0, 0, 0});
+  pbs_inject_ensure_stopped(&ctx);
+  if (pbs_inject_read_at(&ctx, ctx.scratch + PBS_PS4R_HANDLE_OFF, &out_handle, sizeof out_handle)) out_handle = 0;
+  fprintf(report, "Remote Avcap OpenAudio rc=%016llx handle=%016llx\n",
+          (unsigned long long)rc, (unsigned long long)out_handle);
+  if (remote_rc(rc) < 0 || !out_handle || out_handle == 0xa5a5a5a5a5a5a5a5ULL)
+    return remote_rc(rc) < 0 ? remote_rc(rc) : -1;
+  long srt = pbs_inject_call_fast(&ctx, fn_start, (uint64_t[6]){out_handle, 0, 0, 0, 0, 0});
+  fprintf(report, "Remote Avcap audio Start rc=%016llx\n", (unsigned long long)srt);
+  if (remote_rc(srt) < 0) {
+    pbs_inject_call_fast(&ctx, fn_close, (uint64_t[6]){out_handle, 0, 0, 0, 0, 0});
+    return remote_rc(srt);
+  }
+  *handle = (void *)(intptr_t)out_handle;
+  return 0;
+}
+
+int pbs_ps4_remote_audio_read(void *handle, void *out, size_t size, void *info) {
+  if (!remote_ready() || !handle) return -1;
+  return pbs_ps4_export_reader_read(&audio_reader, &ctx, handle, out, size, info, 1);
+}
+
+int pbs_ps4_remote_audio_close(void *handle) {
+  if (!remote_ready() || !handle) return 0;
+  pbs_inject_call_fast(&ctx, fn_stop, (uint64_t[6]){(uint64_t)handle, 0, 0, 0, 0, 0});
+  long rc = pbs_inject_call_fast(&ctx, fn_close, (uint64_t[6]){(uint64_t)handle, 0, 0, 0, 0, 0});
+  fprintf(report, "Remote Avcap audio Stop/Close rc=%016llx\n", (unsigned long long)rc);
+  return remote_rc(rc);
+}
