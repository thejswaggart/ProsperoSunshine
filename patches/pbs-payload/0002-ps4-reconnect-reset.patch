+/* ProsperoSunshine PS4 port: reconnect recovery. Clear the sticky
+ * process-global state that otherwise makes a host process that has streamed
+ * once refuse every later capture: teardown_quarantined and the
+ * control-layer ownership/uncertain flags. Between stream sessions
+ * SceRemotePlay is torn down and respawned, so the previous session's claims
+ * reference a dead process; dropping them lets the next pbs_ps4_capture_begin
+ * attach to the current daemon exactly as a freshly loaded host does. Call
+ * this before pbs_ps4_capture_begin, after the previous session's
+ * pbs_ps4_capture_end. It never issues a remote call, so it is safe even when
+ * the retained context points at a process that no longer exists. */
+void pbs_ps4_capture_reset(FILE *log) {
+  report = log;
+#if PBS_PS4_REMOTE_AVCAP
+  if (pbs_ps4_remote_capture_active()) pbs_ps4_remote_capture_end();
+  pbs_ps4_remote_reset();
+#endif
+  if (pbs_ps4_control_ctx()) pbs_ps4_control_ctx_release();
+  pbs_ps4_control_reset(log);
+  if (log && (teardown_quarantined || local_term_uncertain || configured || initialized))
+    fprintf(log,
+            "PS4 capture reset: clearing quarantine=%d term_uncertain=%d configured=%d initialized=%d\n",
+            teardown_quarantined, local_term_uncertain, configured, initialized);
+  teardown_quarantined = 0;
+  local_term_uncertain = 0;
+  configured = 0;
+  initialized = 0;
+}
+
