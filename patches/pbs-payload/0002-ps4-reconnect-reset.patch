+/* ProsperoSunshine PS4 port: reconnect recovery. Forget every cached attach
+ * detail so the next pbs_ps4_remote_capture_init() copies a freshly attached
+ * control context (a new SceRemotePlay pid after a respawn) instead of the
+ * stale one. The resolved fn_* / reader handles belonged to the previous
+ * daemon image and must be re-resolved. Any worker socket in a now-dead
+ * daemon is released with that process; against a still-live daemon the
+ * control-context release detaches it. Does not call into the tracee. */
+void pbs_ps4_remote_reset(void) {
+  attached = 0;
+  memset(&ctx, 0, sizeof ctx);
+  fn_init = fn_open = fn_start = fn_stop = fn_close = 0;
+  fn_info = fn_set_info = fn_static = 0;
+  fn_idle = 0;
+  fn_status = 0;
+  status_probe_attempted = 0;
+  native_context = 0;
+  fn_native_ensure = 0;
+  native_started = 0;
+#if PBS_PS4_EXPORTED_READ
+  memset(&export_reader, 0, sizeof export_reader);
+  memset(&audio_reader, 0, sizeof audio_reader);
+  fn_open_audio = 0;
+#endif
+}
